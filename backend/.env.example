# ============================================================
# NirmaanSetu Backend Environment Variables (Spring Boot)
# ============================================================

# Server port (Provided automatically by Vercel in container deployment)
PORT=80

# Active Spring Profile: 'dev' for in-memory H2 (default), 'prod' for PostgreSQL
SPRING_PROFILES_ACTIVE=dev

# JWT Security Configuration
JWT_SECRET=NirmaanSetu2024SecureJWTSecretKeyForHMACShA256SignatureAlgorithm
JWT_EXPIRATION_MS=3600000

# Enable/Disable Demonstration seed data indicator
DEMO_MODE=true

# Database Configuration (Required only when SPRING_PROFILES_ACTIVE=prod)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nirmaansetu
DB_USER=nirmaansetu_user
DB_PASSWORD=changeme
